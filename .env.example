# ---- Database (Neon / Vercel Postgres) ----
# Pooled connection (pgbouncer). La usan las funciones serverless: SIEMPRE con
# ?pgbouncer=true&connection_limit=1 para no agotar conexiones.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
# Conexión directa (sin -pooler en el host). Solo la usa prisma migrate / db push.
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ---- App ----
# Public base URL of the deployed site (used for Mercado Pago redirects & QR)
NEXT_PUBLIC_SITE_URL="https://tortasdonmanuel.com"

# ---- Admin session ----
# Long random string. Generate with: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-secret"

# ---- Seed admin (used once by the seed script) ----
SEED_ADMIN_EMAIL="admin@tortasdonmanuel.com"
SEED_ADMIN_PASSWORD="ChangeThisPassword123!"
# Multiple team accounts, create-only: "email:password,email:password"
SEED_ADMINS=""

# ---- Mercado Pago ----
# From https://www.mercadopago.com.mx/developers/panel
MERCADOPAGO_ACCESS_TOKEN=""
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""
# Enable/disable online card payments without redeploying ("true" / "false")
NEXT_PUBLIC_PAYMENTS_ENABLED="false"

# ---- Store contact (shown on site, used for WhatsApp order fallback) ----
NEXT_PUBLIC_STORE_PHONE="5556312022"
NEXT_PUBLIC_STORE_WHATSAPP="525556312022"

# ---- WhatsApp Cloud API (Meta) — order notifications to the owner ----
# From https://developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Any secret string; must match the "Verify token" you type when configuring
# the webhook (callback URL: https://<site>/api/webhooks/whatsapp)
WHATSAPP_VERIFY_TOKEN=""
# Owner phone that receives new-order alerts and can reply to update status.
# Editable later from the admin panel (Ajustes > WhatsApp de avisos).
WHATSAPP_NOTIFY_NUMBER="5527928137"
